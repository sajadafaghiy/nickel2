---
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'خلاصه‌خانه | خلاصهٔ کتاب به فارسی',
  description = 'خلاصه‌های کوتاه و خواندنی از کتاب‌های ارزشمند به زبان فارسی',
} = Astro.props;

const books = (await getCollection('books', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'fa'));
const currentPath = Astro.url.pathname;

const searchableText = (book: (typeof books)[number]) => [
  book.data.title,
  book.data.author,
  book.data.category,
  book.data.description,
  book.body,
].join(' ');
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={import.meta.env.BASE_URL} aria-label="صفحهٔ اصلی خلاصه‌خانه">
          <span class="brand-mark" aria-hidden="true">خ</span>
          <span>خلاصه‌خانه</span>
        </a>
        <div class="header-search">
          <label class="search-field">
            <span class="sr-only">جست‌وجو در همهٔ متن کتاب‌ها</span>
            <span aria-hidden="true">⌕</span>
            <input id="book-search" type="search" placeholder="جست‌وجو در کتاب‌ها…" autocomplete="off" aria-controls="search-results" />
          </label>
          <div class="search-results" id="search-results" hidden>
            <p class="search-status" id="search-status"></p>
            <ul id="search-result-list"></ul>
          </div>
        </div>
      </div>
    </header>
    <div class="site-body">
      <aside class="sidebar">
        <nav aria-label="فهرست کتاب‌ها">
          <details class="books-menu">
            <summary>
              <span class="books-menu-label">
                <span class="books-menu-icon" aria-hidden="true">☰</span>
                <span>کتاب‌ها</span>
              </span>
              <span class="books-menu-meta">
                <small>{books.length.toLocaleString('fa-IR')}</small>
                <span class="books-menu-chevron" aria-hidden="true">⌄</span>
              </span>
            </summary>
            <div class="books-menu-panel">
              <ul class="sidebar-list" id="book-list">
                {books.map((book) => {
                  const href = `${import.meta.env.BASE_URL}books/${book.id}/`;
                  return (
                    <li data-search={searchableText(book)} data-title={book.data.title} data-author={book.data.author} data-href={href}>
                      <a href={href} aria-current={currentPath === href ? 'page' : undefined}>
                        <span>{book.data.title}</span>
                        <small>{book.data.author}</small>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </details>
        </nav>
      </aside>
      <main class="site-main"><slot /></main>
    </div>
    <footer class="site-footer">
      <div class="container">با علاقه به کتاب و یادگیری ساخته شده است.</div>
    </footer>
    <script>
      const input = document.querySelector<HTMLInputElement>('#book-search');
      const items = [...document.querySelectorAll<HTMLElement>('#book-list > li')];
      const results = document.querySelector<HTMLElement>('#search-results');
      const resultList = document.querySelector<HTMLUListElement>('#search-result-list');
      const status = document.querySelector<HTMLElement>('#search-status');

      const normalize = (value: string) => value
        .toLocaleLowerCase('fa')
        .replace(/[يى]/g, 'ی')
        .replace(/ك/g, 'ک')
        .replace(/[\u064B-\u065F\u0670]/g, '')
        .trim();

      const plainText = (value: string) => value
        .replace(/^---[\s\S]*?---/, '')
        .replace(/[#>*_`[\]()!-]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();

      const makePreview = (text: string, query: string) => {
        const clean = plainText(text);
        const index = normalize(clean).indexOf(query);
        if (index < 0) return clean.slice(0, 130);
        const start = Math.max(0, index - 55);
        const end = Math.min(clean.length, index + query.length + 85);
        return `${start ? '…' : ''}${clean.slice(start, end)}${end < clean.length ? '…' : ''}`;
      };

      input?.addEventListener('input', () => {
        const query = normalize(input.value);
        if (!results || !resultList || !status) return;
        resultList.replaceChildren();

        if (!query) {
          results.hidden = true;
          return;
        }

        const matches = items.filter((item) => normalize(item.dataset.search ?? '').includes(query));
        status.textContent = matches.length ? `${matches.length.toLocaleString('fa-IR')} نتیجه` : 'نتیجه‌ای پیدا نشد.';

        for (const item of matches) {
          const link = document.createElement('a');
          const title = document.createElement('strong');
          const author = document.createElement('small');
          const preview = document.createElement('p');
          const listItem = document.createElement('li');
          link.href = item.dataset.href ?? '#';
          title.textContent = item.dataset.title ?? '';
          author.textContent = item.dataset.author ?? '';
          preview.textContent = makePreview(item.dataset.search ?? '', query);
          link.append(title, author, preview);
          listItem.append(link);
          resultList.append(listItem);
        }
        results.hidden = false;
      });

      document.addEventListener('click', (event) => {
        if (results && !event.composedPath().some((node) => node instanceof Element && node.closest?.('.header-search'))) {
          results.hidden = true;
        }
      });
    </script>
  </body>
</html>
